node_modules/
vendor/
# ...except the update checker's own, which is part of the vendored library and
# has to ship: without it the plugin fatals on any site it updates.
!plugin-update-checker/vendor/
dist/
*.log
.DS_Store
test-results/
playwright-report/

# Real staging credentials for the Playwright suite. Never commit this.
# Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example
.wp-test/

# Playwright MCP session output
.playwright-mcp/

# Machine-local Claude Code settings. Team policy belongs in .claude/settings.json,
# which is tracked; anything specific to one machine goes here and is never committed.
.claude/settings.local.json
