# Playwright test target.
#
# YOU PROBABLY DO NOT NEED THIS FILE.
#
# The suite defaults to the local harness in .wp-test, which serves this working
# tree — so a bare `npx playwright test` already tests the code in front of you,
# with no .env at all. Start the harness first:
#
#   node ../bluegroup_core_foundation/scripts/wp-test-env.mjs up --plugin .
#
# Copy this file to .env only when you deliberately want to test a DEPLOYED site
# instead. .env is gitignored — never commit real credentials.
#
#   cp .env.example .env
#
# Anything already set in the environment wins over this file, so CI can inject
# these as secrets without a .env present, and a one-off override on the command
# line beats both.
#
# A warning about pointing this at staging: a run against a deployed site tests
# whatever build is deployed there, NOT your branch. It passes or fails for
# reasons that have nothing to do with your change, and reads as authoritative
# either way. Point it at staging when you mean to test staging, and put it back
# afterwards.

# Base URL of the WordPress install to test against.
# Defaults to http://127.0.0.1:8881 (the local harness) when unset.
# The suite SKIPS every admin test if this contains "placeholder" — the escape
# hatch for an environment with nowhere to point.
PLAYWRIGHT_BASE_URL=

# An administrator on that site.
# Defaults to the harness account (admin / wptest-admin-pw) when unset.
WP_ADMIN_USER=
WP_ADMIN_PASS=

# Slug of the login form. The plugin's `login` feature moves the form off
# wp-login.php and blocks the default path, so this must match the site.
# Give the slug WITHOUT a leading slash. Defaults to admin_login when unset.
WP_LOGIN_PATH=
